  <!-- 5. GANTT CHART -->
  <br clear=all style='mso-special-character:line-break;page-break-before:always'>
  <h2>5. 16-Week Project Schedule Gantt Chart</h2>
  <p>Timeline spanning 16 weeks from <strong>August 1, 2026 to November 21, 2026</strong>.</p>

  <table class="data-table">
    <thead>
      <tr>
        <th rowspan="2" style="width:5%;">ID</th>
        <th rowspan="2" style="width:22%;">Work Package</th>
        <th rowspan="2" style="width:14%;">Owner</th>
        <th rowspan="2" style="width:5%;">Days</th>
        <th rowspan="2" style="width:8%;">Status</th>
        <th colspan="4" style="text-align:center;">August 2026</th>
        <th colspan="4" style="text-align:center;">September 2026</th>
        <th colspan="4" style="text-align:center;">October 2026</th>
        <th colspan="4" style="text-align:center;">November 2026</th>
      </tr>
      <tr>
        <th class="gantt-c">W1</th><th class="gantt-c">W2</th><th class="gantt-c">W3</th><th class="gantt-c">W4</th>
        <th class="gantt-c">W5</th><th class="gantt-c">W6</th><th class="gantt-c">W7</th><th class="gantt-c">W8</th>
        <th class="gantt-c">W9</th><th class="gantt-c">W10</th><th class="gantt-c">W11</th><th class="gantt-c">W12</th>
        <th class="gantt-c">W13</th><th class="gantt-c">W14</th><th class="gantt-c">W15</th><th class="gantt-c">W16</th>
      </tr>
    </thead>
    <tbody>
