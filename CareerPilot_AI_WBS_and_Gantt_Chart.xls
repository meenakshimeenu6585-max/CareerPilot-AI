   <Interior ss:Color="#2563EB" ss:Pattern="Solid"/>
  </Style>

  <!-- Gantt Bar: Planned -->
  <Style ss:ID="GanttBarPlanned">
   <Alignment ss:Horizontal="Center" ss:Vertical="Center"/>
   <Borders>
    <Border ss:Position="Bottom" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#94A3B8"/>
    <Border ss:Position="Top" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#94A3B8"/>
    <Border ss:Position="Left" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#94A3B8"/>
    <Border ss:Position="Right" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#94A3B8"/>
   </Borders>
   <Font ss:FontName="Segoe UI" ss:Size="8" ss:Bold="1" ss:Color="#FFFFFF"/>
   <Interior ss:Color="#94A3B8" ss:Pattern="Solid"/>
  </Style>

  <!-- Gantt Empty Cell -->
  <Style ss:ID="GanttEmpty">
   <Borders>
    <Border ss:Position="Bottom" ss:LineStyle="Hairline" ss:Color="#E2E8F0"/>
    <Border ss:Position="Left" ss:LineStyle="Hairline" ss:Color="#E2E8F0"/>
    <Border ss:Position="Right" ss:LineStyle="Hairline" ss:Color="#E2E8F0"/>
